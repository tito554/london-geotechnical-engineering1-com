</head><body><header class="header"><div class="header-top"><div class="brand"><div class="brand-logo"></div><div class="brand-text"><div class="brand-name">GEOTECHNICAL ENGINEERING1</div><div class="brand-city">London, UK</div></div></div><a class="header-email" href="mailto:contact@geotechnical-engineering1.com">contact@geotechnical-engineering1.com</a></div><div class="crumb-1063-1063"><a href="/">Home</a> › <a href="#"></a> › <span>Geotechnical Engineering Services in London</span></div><h1>Geotechnical Engineering Services in London</h1></header><div class="layout"><aside><a class="sb-home" href="/">Home</a><div class="cat-item" data-cat="investigation"><div class="cat-row"><a href="investigation/" class="cat-name">Investigation</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Investigation"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="exploratory-pit/">Exploratory test pit</a><a href="cone-penetration/">CPT (Cone Penetration Test)</a><a href="standard-penetration/">SPT (Standard Penetration Test)</a></div></div><div class="cat-item" data-cat="in-situ-testing"><div class="cat-row"><a href="in-situ-testing/" class="cat-name">In-Situ</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir In-Situ"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="field-density/">Field density test (sand cone method)</a><a href="porchet-double-ring-infiltrometer/">Infiltration test (Porchet/Double-ring infiltrometer)</a><a href="flat-dilatometer/">Flat Dilatometer Test (DMT)</a><a href="menard-pressuremeter/">Ménard pressuremeter test (PMT)</a><a href="field-vane-shear/">Field vane shear test (VST)</a></div></div><div class="cat-item" data-cat="laboratory"><div class="cat-row"><a href="laboratory/" class="cat-name">Laboratory</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Laboratory"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="grain-size-analysis/">Grain size analysis (sieve + hydrometer)</a><a href="unconfined-compression/">Unconfined compression test (UCS)</a><a href="laboratory-cbr/">Laboratory CBR test</a><a href="standard-modified/">Proctor test (Standard or Modified)</a><a href="soil-mechanics-study/">Soil mechanics study</a><a href="atterberg-limits/">Atterberg limits</a></div></div><div class="cat-item" data-cat="geophysics"><div class="cat-row"><a href="geophysics/" class="cat-name">Geophysics</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Geophysics"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="shear-wave-velocity/">MASW / VS30 (shear wave velocity)</a><a href="electrical-resistivity-ves/">Electrical resistivity / VES (Vertical Electrical Sounding)</a></div></div><div class="cat-item" data-cat="foundations"><div class="cat-row"><a href="foundations/" class="cat-name">Foundations</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Foundations"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="differential-settlement-analysis/">Differential settlement analysis</a><a href="bearing-capacity-analysis/">Bearing capacity analysis</a><a href="shallow-foundation-design/">Shallow foundation design</a><a href="seismic-foundation-design/">Seismic foundation design</a><a href="pile-foundation-design/">Pile foundation design</a><a href="micropile-design/">Micropile design</a><a href="collapsible-soil-evaluation/">Collapsible soil evaluation</a></div></div><div class="cat-item" data-cat="slopes"><div class="cat-row"><a href="slopes/" class="cat-name">Slopes</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Slopes"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="soil-erosion-analysis/">Soil erosion analysis</a><a href="slope-stability-analysis/">Slope stability analysis</a><a href="slope-failure-analysis/">Slope failure analysis</a><a href="factor-safety/">Factor of safety (FS) calculation</a><a href="slope-stabilization-design/">Slope stabilization design</a><a href="retaining-wall-design/">Retaining wall design</a><a href="mechanically-stabilized-earth/">MSE (Mechanically Stabilized Earth) wall design</a><a href="sheet-pile-wall-design/">Sheet pile wall design</a></div></div><div class="cat-item" data-cat="ground-improvement"><div class="cat-row"><a href="ground-improvement/" class="cat-name">Improvement</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Improvement"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="stone-column-design/">Stone column design</a><a href="deep-soil-mixing/">Deep Soil Mixing (DSM) design</a><a href="geotechnical-drainage-design/">Geotechnical drainage design</a><a href="vibrocompaction-design/">Vibrocompaction design</a><a href="lime-cement-stabilization/">Lime and cement stabilization</a><a href="contaminated-soil-remediation/">Contaminated soil remediation</a></div></div><div class="cat-item" data-cat="road-geotechnics"><div class="cat-row"><a href="road-geotechnics/" class="cat-name">Road Geotechnics</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Road Geotechnics"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="flexible-pavement-design/">Flexible pavement design</a><a href="cbr-study-road-design/">CBR study for road design</a><a href="existing-pavement-evaluation/">Existing pavement evaluation</a><a href="pavement-subgrade-design/">Road geotechnics (pavement/subgrade design)</a></div></div><div class="cat-item" data-cat="seismic"><div class="cat-row"><a href="seismic/" class="cat-name">Seismic</a><button class="cat-toggle" aria-expanded="false" aria-label="Expandir Seismic"><span class="cat-arrow">▼</span></button></div><div class="cat-sub" hidden><a href="seismic-amplification-analysis/">Seismic amplification analysis</a><a href="soil-liquefaction-analysis/">Soil liquefaction analysis</a><a href="seismic-microzonation/">Seismic microzonation</a></div></div></aside><main><p>Our team provides comprehensive geotechnical services across London, from site characterization and foundation design to subsurface investigation and construction monitoring. We understand the unique demands of the city’s dense urban environment, where existing infrastructure and variable ground conditions require careful planning. Our work covers a full spectrum of capabilities, including <a data-interlink="1" href="soil-mechanics-study/">soil mechanics studies</a>, retaining wall design, and <a data-interlink="1" href="slope-stability-analysis/">slope stability analysis</a>, ensuring that every project is built on a reliable geotechnical foundation. By integrating local knowledge with rigorous engineering practices, we deliver solutions that are both practical and code-compliant, supporting developments from high-rise towers to transport infrastructure.</p><figure style="margin:1.5rem auto;max-width:720px;text-align:center"><img src="img/calicatas-exploratorias-2.webp" loading="eager" decoding="async" width="800" height="600" alt="Illustrative image of Exploratory test pit in London" style="width:100%;height:auto;display:block;border-radius:8px;border:1px solid #E5E7EB" fetchpriority="high"></figure><figure style="margin:1.5rem auto;max-width:60%;border-radius:6px;overflow:hidden;border:1px solid #E5E5E5"></figure><h2>Scope of work</h2><div>London’s subsurface is dominated by the London Clay Formation, a stiff, fissured overconsolidated clay that can reach depths of over 100 meters in the central basin. This clay is underlain by the Lambeth Group and Thanet Sand Formation, with the chalk bedrock appearing at greater depths. Groundwater is typically confined within the deeper aquifers, though perched water tables can occur within granular layers. The region experiences low seismic hazard, but geotechnical challenges include swelling and shrinkage of clay due to seasonal moisture changes, and the presence of historical made ground from centuries of urban development. In the Thames Valley, alluvial deposits and river terrace gravels add variability, requiring careful assessment for shallow foundations and retaining structures. Understanding these conditions is critical for safe and economical design, particularly for deep excavations and tunnelling projects.</div><h2>Area-specific notes</h2><hr style="border:none;height:2px;background:linear-gradient(90deg,transparent,#A16207,transparent);margin:2rem 0;width:60%;margin-left:auto;margin-right:auto"><p>Our firm brings consolidated regional background to every London project, having worked extensively with the London Clay and other local formations. We maintain calibrated <a href="/laboratory/">laboratory</a> equipment and field instrumentation to deliver accurate, code-compliant reports. Our team coordinates directly with local contractors, planning authorities, and building control bodies to streamline approvals and mitigate risks. By staying current with evolving standards and local practices, we supply geotechnical solutions that are both technically sound and contextually appropriate, supporting safe and efficient development across the capital.</p><section class="block mid-cta-1063-1063" style="padding:2rem 0"><div style="max-width:720px;margin:0 auto;background:linear-gradient(135deg,#A1620715,#A1620708);border-left:4px solid #A16207;padding:1.5rem 1.8rem;border-radius:6px;text-align:center"><h3 style="margin:0 0 .4rem;font-size:1.15rem;color:#1E293B;text-align:center">Need a geotechnical assessment?</h3><p style="margin:0 0 1rem;color:#64748B;font-size:.92rem;text-align:center">Reply within 24h.</p><a href="mailto:contact@geotechnical-engineering1.com" style="display:inline-block;background:#A16207;color:#FFF !important;padding:1rem 2rem;border-radius:8px;text-decoration:none;font-weight:800;font-size:1.05rem;box-shadow:0 4px 12px rgba(0,0,0,.15)">Email: contact@geotechnical-engineering1.com</a></div></section><section class="block video-block" style="padding:3rem 1.5rem"><div style="max-width:1200px;margin:0 auto"><h2 style="margin-bottom:1rem;font-weight:700">Watch how it works</h2><div class="video-wrap" style="position:relative;max-width:600px;margin:1rem auto 0;aspect-ratio:16/9;border-radius:8px;overflow:hidden"><iframe allow="accelerometer;encrypted-media;gyroscope;picture-in-picture" allowfullscreen="" loading="lazy" src="https://www.youtube-nocookie.com/embed/bcJZRBoDAb4" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" title="Explanatory video"></iframe></div></div></section><h2>Standards used</h2><p>Geotechnical work in the UK is governed by Eurocode 7 (EN 1997) for geotechnical design, alongside British Standards such as BS 5930 for site investigation and BS 8004 for foundations. Field testing follows BS EN ISO standards, including BS EN ISO 22476-3 for <a data-interlink="1" href="standard-penetration/">standard penetration tests</a> (SPT) and BS EN ISO 22476-9 for <a data-interlink="1" href="shear-wave-velocity/">shear wave velocity</a> measurements. Laboratory testing adheres to BS 1377 methods for soil classification and strength parameters. These standards ensure consistency and reliability across all project phases, from initial ground investigation to final compliance reporting.</p><section class="block sub-services-block" style="padding:3.5rem 1.5rem"><style>/*afx*/.sub-svc-grid-1063 { display:flex; flex-wrap:wrap; gap:1.5rem; margin-top:1.5rem; justify-content:center; }
.sub-svc-arrow-1063 { position:absolute; right:1rem; bottom:.9rem; color:#A16207; font-weight:700; font-size:1.1rem; opacity:.6; transition:transform .18s ease, opacity .18s ease; }
.sub-svc-grid-1063 > .sub-svc, .sub-svc-grid-1063 > a.sub-svc { flex:0 0 calc(25% - 1.125rem); min-width:220px; padding:1rem 1.2rem; border:1px solid #E5E7EB; border-radius:10px; background:#FFFFFF; transition:border-color .18s ease, box-shadow .18s ease, transform .18s ease; position:relative; }
.sub-svc-grid-1063 > a.sub-svc-link-1063:hover .sub-svc-arrow-1063 { transform:translateX(4px); opacity:1; }
.sub-svc-grid-1063 > a.sub-svc-link-1063 { display:block; text-decoration:none; color:inherit; cursor:pointer; }
.sub-svc-grid-1063 > a.sub-svc-link-1063:hover h3 { color:#A16207; }
.sub-svc-grid-1063 > a.sub-svc-link-1063:hover { border-color:#A16207; box-shadow:0 4px 14px rgba(0,0,0,.08); transform:translateY(-2px); }/*sbhfix*/aside .sb-home{color:#FFF !important}</style><div style="max-width:1200px;margin:0 auto"><h2 style="margin-bottom:1.5rem;font-weight:700">Linked services</h2><div class="sub-svc-grid-1063-1063"><a class="sub-svc sub-svc-link-1063-1063" href="standard-penetration/"><div class="sub-svc-num" style="color:#A16207;font-weight:700;font-size:.85rem;letter-spacing:.1em">01</div><h3 style="color:#14532D;font-size:1.1rem;margin:.3rem 0 .5rem">SPT (Standard Penetration Test)</h3><span aria-hidden="true" class="sub-svc-arrow-1063-1063">→</span></a><a class="sub-svc sub-svc-link-1063-1063" href="soil-mechanics-study/"><div class="sub-svc-num" style="color:#A16207;font-weight:700;font-size:.85rem;letter-spacing:.1em">02</div><h3 style="color:#14532D;font-size:1.1rem;margin:.3rem 0 .5rem">Soil mechanics study</h3><span aria-hidden="true" class="sub-svc-arrow-1063-1063">→</span></a><a class="sub-svc sub-svc-link-1063-1063" href="cone-penetration/"><div class="sub-svc-num" style="color:#A16207;font-weight:700;font-size:.85rem;letter-spacing:.1em">03</div><h3 style="color:#14532D;font-size:1.1rem;margin:.3rem 0 .5rem">CPT (Cone Penetration Test)</h3><span aria-hidden="true" class="sub-svc-arrow-1063-1063">→</span></a><a class="sub-svc sub-svc-link-1063-1063" href="shallow-foundation-design/"><div class="sub-svc-num" style="color:#A16207;font-weight:700;font-size:.85rem;letter-spacing:.1em">04</div><h3 style="color:#14532D;font-size:1.1rem;margin:.3rem 0 .5rem">Shallow foundation design</h3><span aria-hidden="true" class="sub-svc-arrow-1063-1063">→</span></a><a class="sub-svc sub-svc-link-1063-1063" href="pile-foundation-design/"><div class="sub-svc-num" style="color:#A16207;font-weight:700;font-size:.85rem;letter-spacing:.1em">05</div><h3 style="color:#14532D;font-size:1.1rem;margin:.3rem 0 .5rem">Pile foundation design</h3><span aria-hidden="true" class="sub-svc-arrow-1063-1063">→</span></a><a class="sub-svc sub-svc-link-1063-1063" href="retaining-wall-design/"><div class="sub-svc-num" style="color:#A16207;font-weight:700;font-size:.85rem;letter-spacing:.1em">06</div><h3 style="color:#14532D;font-size:1.1rem;margin:.3rem 0 .5rem">Retaining wall design</h3><span aria-hidden="true" class="sub-svc-arrow-1063-1063">→</span></a><a class="sub-svc sub-svc-link-1063-1063" href="slope-stability-analysis/"><div class="sub-svc-num" style="color:#A16207;font-weight:700;font-size:.85rem;letter-spacing:.1em">07</div><h3 style="color:#14532D;font-size:1.1rem;margin:.3rem 0 .5rem">Slope stability analysis</h3><span aria-hidden="true" class="sub-svc-arrow-1063-1063">→</span></a></div></div></section><h2>Q&A</h2><details class="faq"><summary>What are the most common geotechnical challenges for new developments in London?</summary><p>Developments in London frequently encounter the London Clay, which can swell or shrink with moisture changes, affecting shallow foundations and pavements. Made ground from historical activities may contain obstructions or contaminants, requiring careful investigation. Deep excavations often face high groundwater pressures in deeper aquifers, necessitating solid dewatering or waterproofing designs. Additionally, adjacent structures and underground solutions demand precise monitoring to avoid settlement or damage.</p></details><details class="faq"><summary>How does the presence of the London Clay influence foundation design?</summary><p>London Clay is a stiff overconsolidated clay with high bearing capacity but significant shrink-swell potential. For shallow foundations, designs must account for seasonal moisture changes, often using reinforced rafts or strip footings with proper depth. Deep foundations, such as piles, rely on the clay’s end-bearing and shaft friction, but require careful assessment of its fissured nature and potential for long-term creep. Ground movement monitoring is essential for sensitive structures.</p></details><details class="faq"><summary>What regulatory approvals are needed for geotechnical work in London?</summary><p>Geotechnical investigations in London must comply with the Building Regulations 2010, particularly Part A (Structure) and Part C (Site Preparation). Planning permissions often require a preliminary risk assessment and ground investigation report. For sites near watercourses or in flood zones, the Environment Agency may impose additional requirements. Local borough councils also have specific guidelines for piling, excavations, and contamination testing.</p></details><details class="faq"><summary>What typical project types require geotechnical input in London?</summary><p>Common projects include high-rise residential towers, commercial office buildings, transport infrastructure like Crossrail and underground stations, and basement extensions for existing properties. Brownfield redevelopment is frequent, requiring contamination assessment and Improvement. Retaining walls and slope stability analyses are needed for cut-and-cover excavations and embankments. All benefit from a thorough understanding of local geology and existing solutions.</p></details></main></div><section class="block map-block" style="padding:3rem 1.5rem"><div style="max-width:1200px;margin:0 auto"><h2 style="margin-bottom:.8rem;font-weight:700">Location and service area</h2><p style="margin-bottom:1rem;color:#555">We serve projects across London and surrounding areas.</p><div class="map-wrap" style="position:relative;max-width:520px;margin:0 auto;aspect-ratio:4/3;border-radius:8px;overflow:hidden;border:1px solid #E5E7EB"><div id="map_284d5e" style="position:absolute;top:0;left:0;width:100%;height:100%"></div><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script data-mapgen="1">(function(){var m=L.map("map_284d5e",{zoomControl:true,attributionControl:true}).setView([51.5074,-0.1278],11);L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}@2x.png",{attribution:"&copy; OpenStreetMap contributors &copy; CARTO",maxZoom:19,subdomains:"abcd"}).addTo(m);L.circle([51.5074,-0.1278],{radius:5000,color:"#171717",weight:2,fillColor:"#404040",fillOpacity:0.18}).addTo(m).bindPopup("London");})();</script></div><div style="margin-top:.5rem;font-size:.78rem;color:#888;text-align:center">View larger map</div></div></section><footer style="background:#171717;color:rgba(255,255,255,.85);padding:2rem 1.5rem;text-align:center;font-size:.92rem">London, USA · <a href="mailto:contact@geotechnical-engineering1.com" style="color:#FFF;text-decoration:underline">contact@geotechnical-engineering1.com</a><div data-updated="2026-05-07" style="font-size:.78rem;color:rgba(255,255,255,.6);margin-top:.8rem">Last updated: 2026-05-07</div><div data-authority-refs class="authority-refs" style="text-align:center;font-size:.8rem;padding:.5rem 0;opacity:.6"><strong>References:</strong>ASTM Standards · USACE Engineer Manuals · ISO Geotechnical</div></footer><script>(function(){document.querySelectorAll(".cat-toggle").forEach(function(b){b.addEventListener("click",function(e){e.preventDefault();var s=b.parentElement.parentElement.querySelector(".cat-sub");var ex=b.getAttribute("aria-expanded")==="true";b.setAttribute("aria-expanded",!ex);if(s){s.hidden=ex;}});});})();</script></body></html>